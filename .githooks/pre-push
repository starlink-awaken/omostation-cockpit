#!/bin/bash
# Pre-push gate: lint + smoke test
if [ "${SKIP_GATE:-}" = "true" ]; then exit 0; fi
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
echo "🔍 Pre-push: $(basename $REPO_ROOT)"

# ruff check
if command -v ruff &>/dev/null; then
  ruff check src/cockpit/ || { echo "❌ ruff check failed"; exit 1; }
  ruff format --check src/cockpit/ || { echo "❌ format check failed"; exit 1; }
fi

# smoke test: 本地 pre-push 跳过 e2e/integration 等慢测试
if [ -d tests ]; then
  uv run pytest tests/ -q --tb=no -x --ignore=tests/e2e --ignore=tests/integration 2>/dev/null || echo "⚠️  tests failed (non-blocking in dev)"
fi

echo "✅ Pre-push check passed"

# ── CLI-REFERENCE stale reminder ──────────────────────────────
# cockpit 新增/修改命令时, 主仓 docs/CLI-REFERENCE.md 需重生成 (主仓跑 gen-help-docs)
CHANGED_CMD=$(git diff --name-only origin/main..HEAD -- src/cockpit/commands/ src/cockpit/cli.py 2>/dev/null | head -1)
if [ -n "$CHANGED_CMD" ]; then
    echo "💡 cockpit commands changed — 主仓需重跑: uv run --with pyyaml python bin/ssot/gen-help-docs.py --write"
fi
